<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forget Password</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        body {
            background-color: rgb(51, 51, 51);
            width: 100vw;
            height: 100vh;
            color: white;
            font-family: 'Arial Black';
            text-align: center;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .error-num {
            font-size: 8em;
        }

        .eye {
            background: #fff;
            border-radius: 50%;
            display: inline-block;
            height: 100px;
            position: relative;
            width: 100px;
        }

        .eye::after {
            background: #000;
            border-radius: 50%;
            bottom: 56.1px;
            content: '';
            height: 33px;
            position: absolute;
            right: 33px;
            width: 33px;
        }

        .error-message {
            font-size: 28px;
            text-align: center;
            color: white;
            margin-bottom: 20px;
        }

        .contact-list {
            list-style: none;
            padding: 0;
            margin: 0;
            text-align: center;
        }

        .contact-list li {
            margin-bottom: 10px;
        }

        .contact-list li a {
            color: white;
            text-decoration: none;
        }

        .contact-list li a:hover {
            text-decoration: underline;
        }
        .button {
            display: inline-block;
            padding: 10px 20px;
            background-color: #f0f0f0;
            border: 1px solid #999999;
            border-radius: 5px;
            text-decoration: none;
            color: #333333;
            font-family: Arial, sans-serif;
        }

        .button:hover {
            background-color: #dddddd;
        }
        
    </style>
</head>
<body>
<div>
    <span class='error-num'>5</span>
    <div class='eye'></div>
    <div class='eye'></div>
    <!-- <span class='error-num'>4</span> -->
    <h1>Sorry Forget Password service is not active for now </h1>

    <p class="error-message">for any queries please contact the web team pulkit.upadhyay@deepeigen.com,vamsikrishna@deepeigen.com,aakriti@deepeigen.com</p>
    <ul class="contact-list">
        <li><a href="mailto:pulit.upadhyay@deepeigen.com">pulit.upadhyay@deepeigen.com</a></li>
        <li><a href="mailto:vamsikrisna@deepeigen.com">vamsikrisna@deepeigen.com</a></li>
        <li><a href="mailto:aakriti@deepeigen.com">aakriti@deepeigen.com</a></li>
    </ul>
    <a href="/" class="button">Go back</a>
</div>
</body>
<script>
    $(document).ready(function () {
        $('body').on('mousemove', function (event) {
            var container = $('body');
            var containerOffset = container.offset();
            var centerX = containerOffset.left + container.width() / 2;
            var centerY = containerOffset.top + container.height() / 2;
            var angle = Math.atan2(event.pageY - centerY, event.pageX - centerX);
            var angleDeg = angle * (180 / Math.PI);
            $('.eye').css({
                '-webkit-transform': 'rotate(' + angleDeg + 'deg)',
                'transform': 'rotate(' + angleDeg + 'deg)'
            });
        });
    });
</script>

</html>
