              <i class='fas fa-file-invoice-dollar' onclick="showInvoice('${path}')" style="cursor:pointer;" ></i>   
              
              
                    </td>
           </tr>`

}

document.querySelector('#R_table_body').innerHTML = inner_html;

// for charts 

// for amaount chart 
// removing previous canvas

var canvasToRemove = document.getElementById('dayWiseChart')
var canvasToRemove2 = document.getElementById('employeeWiseChart')

canvasToRemove.parentNode.removeChild(canvasToRemove);
canvasToRemove2.parentNode.removeChild(canvasToRemove2);


const canvas1 = document.createElement('canvas');
const canvas2 = document.createElement('canvas');

canvas1.id = 'dayWiseChart';
canvas2.id = 'employeeWiseChart';

const parentDiv = document.getElementById('chart-container');
const parentDiv2 = document.getElementById('employee-chart-container');

parentDiv.appendChild(canvas1);
parentDiv2.appendChild(canvas2);



// canvas rendr-remove end

const dataWithAmounts = dayWiseData.map(data => ({ date: moment(data.Date), amount: data.Amount }));

// Sort the array based on dates
dataWithAmounts.sort((a, b) => a.date - b.date);

// Extract sorted dates and amounts arrays
const dates = dataWithAmounts.map(item => item.date.format('MMM DD'));
const amounts = dataWithAmounts.map(item => item.amount);


  const amountWiseCtx = document.getElementById('dayWiseChart').getContext('2d');
