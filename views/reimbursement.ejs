<script>
   function formatDateToDDMMYYYY(date) {
       
       date = new Date(date)
   const day = String(date.getDate()).padStart(2, '0');
   const month = String(date.getMonth() + 1).padStart(2, '0'); // Months are zero-based
   const year = date.getFullYear();
 
   return `${day}-${month}-${year}`;
}

function DateChange() {
   var selectBox = document.getElementById("Time");
   var specificDateDiv = document.getElementById("specificDate");
 
   if (selectBox.value === "specific_date") {
     specificDateDiv.style.display = "block";
   } else {
     specificDateDiv.style.display = "none";
   }
 }
     function filterByDateRange(D_type) {


if(document.querySelector('#Time').value=="specific_date"){

 DateChange();
 document.querySelector('#Time').value = "none";
 return;
}



     var  today = new Date()
       console.log('fanction chal gaya')
   // Check if the dates are in the correct format
   
   
   if(D_type == "Specific"){
     console.log('specific tha chutiyon')
     var from_d = document.querySelector('#fromDate').value;
   var to_d = document.querySelector('#toDate').value;

   // Check if from date and to date are provided
   if (!from_d || !to_d) {
       console.error('Both from date and to date are required.');
       return;
   }

   var fromDate = new Date(from_d).setHours(0,0,0,0);
   var toDate = new Date(to_d).setHours(0,0,0,0);

  //  if (isNaN(fromDate.getTime()) || isNaN(toDate.getTime())) {
  //      console.error('Invalid date format. Please enter dates in YYYY-MM-DD format.');
  //      return;
  //  }
   if (fromDate > toDate) {
       console.error('From date must be less than or equal to to date.');
       return;
   }

 }else if (D_type == "Particular"){

document.querySelector('#specificDate').style.display = 'none'

   console.log('perticuler tha chutiyon')

var sel = document.querySelector('#Time').value
console.log(sel)
if(sel=="1_month"){

   var fromDate = new Date(today);
fromDate.setDate(today.getDate() - 30);
var toDate =today;
// console.log(fromDate,toDate)
 }else if(sel == "3_months"){


   var fromDate = new Date(today);
fromDate.setDate(today.getDate() - 90);
var toDate =today;
// console.log(fromDate,toDate)

 }else if(sel == "6_months"){
   var fromDate = new Date(today);
fromDate.setDate(today.getDate() - 180);
var toDate = today;
 }else if(sel == "1_year"){
   var fromDate = new Date(today);
fromDate.setDate(today.getDate() - 365);
var toDate = today;
 }
 }


//  console.log(fromDate,toDate)
  

   // Check if from date is less than or equal to to date
  
   var lots = JSON.parse('<%- JSON.stringify(full_reimbursement) %>');

   // Filter lots based on date range
   var filteredLots = lots.filter(function (lot) {
       var purchaseDate = new Date(lot.Date).setHours(0,0,0,0);
       return purchaseDate >= fromDate && purchaseDate <= toDate;
   });

  //  console.log(filteredLots);
  var dayWiseData = filteredLots;

var inner_html= ``;

for(var i=0; i < filteredLots.length; i++){
  var path;
if(filteredLots[i].Invoice){
  path = filteredLots[i].Invoice
path = path.replace('public/', '');
console.log(path)
}
  
 inner_html = inner_html + `<tr>
             <td> ${filteredLots[i].employee.Name}  </td>
            

             <td>${formatDateToDDMMYYYY(filteredLots[i].Date)}
               
               
             
               </td>
