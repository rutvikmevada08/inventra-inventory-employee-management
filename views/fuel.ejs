<style>
   button {
    padding: 10px 20px;
    margin-right: 10px;
    background-color: #007bff;
    color: #fff;
    border: none;
    cursor: pointer;
  }

  button:hover {
    background-color: #0056b3;
  }

  .container {
    position: relative;
    width: 100%;
  }

  .right-aligned {
    position: absolute;
    top: -22px;
    right: 0;
  }

  .right-aligned button {
    border-radius: 5px;
  }

  .overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 999;
  }

  .close-icon {
    position: absolute;
    top: 10px;
    right: 10px;
    cursor: pointer;
    font-size: 20px;
    color: #ccc;
  }

  .close-icon:hover {
    color: #555;
  }

  .form-container {
    display: none;
    position: absolute;
    top: 50%;
    left: 50%;
    width: 60%;
    transform: translate(-50%, -50%);
    background-color: #fff;
    padding: 20px;
    border-radius: 5px;
    z-index: 1000;
  }

  .form-container.active {
    display: block;
  }


   /* vehicle Form */
  #vehicleForm {
    background-color: #f9f9f9;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    width: 50%;
  }

  #vehicleForm h2 {
    font-family: Montserrat;
    font-weight: 700;
    color: #0056b3;
    margin-bottom: 20px;
  }

  #vehicleForm label {
    font-weight: 600;
  }

  #vehicleForm input[type="text"],
  #vehicleForm input[type="email"],
  #vehicleForm input[type="tel"] {
    width: calc(100% - 40px);
    padding: 10px;
    margin-bottom: 10px;
    border: 1px solid #ccc;
    border-radius: 5px;
    font-size: 16px;
  }

  #vehicleForm input[type="submit"] {
    background-color: #007bff;
    color: #fff;
    border: none;
    border-radius: 5px;
    padding: 10px 20px;
    cursor: pointer;
    font-size: 16px;
  }

  #vehicleForm input[type="submit"]:hover {
    background-color: #0056b3;
  }

</style>
<body>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
  <script src='https://kit.fontawesome.com/a076d05399.js' crossorigin='anonymous'></script>
  


 
  <%- include('./sidenavbar.ejs') %>
  <%- include('./alert_msg.ejs') %>

 <%
  function formatDateToDDMMYYYY(date) {
    const day = String(date.getDate()).padStart(2, '0');
    const month = String(date.getMonth() + 1).padStart(2, '0'); // Months are zero-based
    const year = date.getFullYear();
  
    return `${day}-${month}-${year}`;
 }
 %>

 <section id="content">
  <nav>
    <i class="bx bx-transfer-alt"></i>
    <div class="container">
      <div class="right-aligned">
        <button onclick="toggleForm('vehicleForm')">Add Vehicle</button>
        <button onclick="toggleFuelSection()">Add Refuel</button>
      </div>
      </div>
  </nav>

  <div class="overlay" onclick="closeForms()"></div>

  <div id="vehicleForm" class="form-container">
    <h2 style="font-family: Montserrat; font-weight: 700; color: #0056b3;">Add Vehicle</h2>
    <span class="close-icon" onclick="closeForm('vehicleForm')"><i class='bx bx-x'></i></span>
   
   
    <form action="/add-vehicle" method="post" >
      <label for="vehicleName">Name:</label><br>
      <input type="text" id="vehicleName" name="Vehicle_name" style="width: 100%;"  required ><br>
      <label for="vehicleName">Number:</label><br>
      <input type="text" id="vehicleName" name="Vehicle_number" style="width: 100%;" required ><br>

      <button type="submit"  id="emp_submit">Add Vehicle</button>
    </form>



  </div>


     <!-- fuel Section -->
     <main id="fuelDetail">
      <div class="head-title">
        <div class="left">
          <h1>Fuel</h1>
          <ul class="breadcrumb">
            <li>
              <a href="#">Fuel</a>
            </li>
            <li><i class='bx bx-chevron-right'></i></li>
            <li>
              <a class="active" href="#">Dashboard</a>
            </li>
          </ul>
        </div>

      </div>
      <ul class="box-info">
        <li>
          <i class='bx bxs-gas-pump'></i>
          <span class="text">
            <h3><%=currentMonthEntries.length%> Times</h3>
            <p>Total Refuel Count This Month</p>
          </span>
        </li>
        <li>
          <i class='bx bxs-car'></i>
          <span class="text">
            <h3><%=totalLitresThisMonth%> Litres</h3>
            <p> Fuel Used This Month</p>
          </span>
        </li>
        <li>
          <i class='bx bx-rupee'></i>

          <span class="text">
            <h3>₹ <%=totalInvestmentThisMonth%></h3>
            <p>Total Invested In Fuel</p>
          </span>
        </li>
      </ul>




      <div id="fuelSection" style="display: none;">
      <div class="table-data">
        <form action="/add-refuel" method="post" class="todo-section" id="fuelSection" onsubmit="hideForm()" enctype="multipart/form-data" >
          <div class="head">
            <h3> Add Refuel</h3>
          </div>
          <ul class="todo-list1">
            <li>
              <table class="report-table" id="invoiceFuel">
                <tr>
                  <td style="font-weight: 500;">Invoice Number</td>
                  <td> <input type="text" name="Invoice_number" id=""  required> </td>
              </tr>
                <tr>
                  <td style="font-weight: 500;">Vendor</td>
                  <td> <select class="form-control" id="vendor" name="vendor" required>
                    
                    <% for(var i=0; i< vendors.length; i++){ %>
                    <option value="<%=vendors[i]._id%>"><%=vendors[i].Business_name%></option>
                    <%}%>
                  </select></td>
              </tr>
                <tr>
                  <td style="font-weight: 500;">Date & Time</td>
                  <td><input type="datetime-local" class="form-control" id="datetime" name="Date" required
                     ></td>
                </tr>
                <tr>
                  <td style="font-weight: 500;">How many litres</td>
                  <td>
                    <input type="number" class="form-control" id="how_many_litre" name="Litre">
                  </td>
                </tr>
                <tr>
                  <td style="font-weight: 500;">Cost per litre</td>
                  <td><input type="number" class="form-control" id="costperlitre" name="Cost_per_litre" required></td>
                </tr>
                <tr>
                  <td style="font-weight: 500;">Total payable</td>
                  <td><input type="number" class="form-control" id="total_payable" name="Total" required></td>
                </tr>
                <tr>
                  <td style="font-weight: 500;">Vehicle Number</td>
                  <td><select class="form-control" id="V_num" name="Vehicle_num" required>
                    <% for(var i=0; i< vehicles.length; i++){ %>
                   <option value="<%=vehicles[i]._id%>"><%=vehicles[i].Vehicle_name%></option>
                    <%}%>
                    </select>
                  </td>
                </tr>
                <tr>
                  <td style="font-weight: 500;">Fuelled by</td>
                  <td>
                    <select class="form-control" id="fuelled_by" name="Fueled_by" required>
                      <% for(var i=0; i< employees.length; i++){ %>
                        <option value="<%=employees[i]._id%>"><%=employees[i].Name%></option>
                        <%}%>
                    </select>
                  </td>
                </tr>
                <tr>
                  <td style="font-weight: 500;">Invoice</td>
                  <td>
                   <input type="file" name="invoice" id="" required>
                  </td>
                </tr>
              </table>


            </li>
          </ul>
          <div class="button-container">
            <!-- <button class="editBtn" id="fuelEditBtn">Edit</button> -->
            <button type="submit" class="doneBtn" id="fuelDoneBtn">Submit</button>
          </div>
        </form>
      </div>
</div>
      <!-- Recent Fuel -->

      <div class="table-data">
        <div class="order">
          <div class="head">
            <h3>Recent ReFuels</h3>

            <div class="filter">
              <label for="Time"><strong> Filter:</strong></label>
              <select id="Time" onchange="filterByDateRange('Particular')">
                <!-- <option value="none">Select Filter</option> -->
    
                <option value="1_month"  >1 Month</option>
                <option value="3_months"  >3 Months</option>
                <option value="6_months"  >6 Months</option>
                <option value="1_year" >1 Year</option>
                <option value="specific_date">Specific Date</option>
              </select>
              <!-- <button type="button" onclick="filterByDateRange('Particular')">Apply</button> -->
            
              <div id="specificDate" style="display: none;">
                <label for="fromDate">From:</label>
                <input type="date" id="fromDate" >
                <label for="toDate">To:</label>
                <input type="date" id="toDate"  >
                <button type="button" onclick="filterByDateRange('Specific')">Apply</button>
              </div>
            </div>
           
          </div>
          <table style="border: 1px solid #dee2e6;">
            <thead>
              <tr style="border: 1px solid #dee2e6;">
                <th>Fuelled By</th>
                <th>Date</th>
                <th>Litre</th>
                <th>Amount</th>
                <th>Vendor</th>
                <th>Vehicle</th>
                <th>Invoice</th>

              </tr>
            </thead>
            <tbody id="R_table_body" >
              <% if (!currentMonthEntries || currentMonthEntries.length === 0) { %>
                <tr>
                  <td></td>
                  <td>No Recent Fuel Added</td>
                </tr>
              <% } else { %> 

              <% for(var i=0; i< currentMonthEntries.length;i++){ %>
              <tr>
                <td> <%= currentMonthEntries[i].Fueled_by.Name %> </td>
                <td><%= formatDateToDDMMYYYY(currentMonthEntries[i].Date) %>  </td>
                <td><%= currentMonthEntries[i].Litre  %>ltr </td>
                <td>₹ <%=  currentMonthEntries[i].Total %> </td>
                <td><%=  currentMonthEntries[i].Vendor.Business_name %> </td>
                <td><%=  currentMonthEntries[i].Vehicle_num.Vehicle_name %> </td>

              </tr>
              <%}%>
              <%}%>
            </tbody>
          </table>
        </div>
