// removing previous canvas

var canvasToRemove = document.getElementById('dayWiseChart')
var canvasToRemove2 = document.getElementById('employeeWiseChart')

canvasToRemove.parentNode.removeChild(canvasToRemove);
canvasToRemove2.parentNode.removeChild(canvasToRemove2);


const canvas1 = document.createElement('canvas');
const canvas2 = document.createElement('canvas');

canvas1.id = 'dayWiseChart';
canvas2.id = 'employeeWiseChart';

