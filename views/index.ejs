<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <link href='https://unpkg.com/boxicons@2.0.9/css/boxicons.min.css' rel='stylesheet'>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@2.1.0/css/boxicons.min.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
  <title>Dashboard</title>
  </head>
<style>
  .action-icon-btn{
    padding: 10px 20px;
    margin-right: 10px;
    background-color: #007bff;
    color: #fff;
    border: none;
    cursor: pointer;
  }

 .action-icon-btn:hover {
    background-color: #0056b3;
  }

  .container {
    position: relative;
    width: 100%;
  }

  .right-aligned {
    position: absolute;
    top: -22px;
    right: 0;
  }

  .right-aligned button {
    border-radius: 5px;
  }

  .overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 999;
  }

  .close-icon {
    position: absolute;
    top: 10px;
    right: 10px;
    cursor: pointer;
    font-size: 20px;
    color: #ccc;
  }

  .close-icon:hover {
    color: #555;
  }

  .form-container {
    display: none;
    position: absolute;
    top: 50%;
    left: 50%;
    width: 60%;
    transform: translate(-50%, -50%);
    background-color: #fff;
    padding: 20px;
    border-radius: 5px;
    z-index: 1000;
  }

  .form-container.active {
    display: block;
  }


   /* employee Form */
  #employeeForm {
    background-color: #f9f9f9;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
  }

  #employeeForm h2 {
    font-family: Montserrat;
    font-weight: 700;
    color: #0056b3;
    margin-bottom: 20px;
  }

  #employeeForm label {
    font-weight: 600;
  }

  #employeeForm input[type="text"],
  #employeeForm input[type="email"],
  #employeeForm input[type="tel"] {
    width: calc(100% - 40px);
    padding: 10px;
    margin-bottom: 10px;
    border: 1px solid #ccc;
    border-radius: 5px;
    font-size: 16px;
  }

  #employeeForm input[type="submit"] {
    background-color: #007bff;
    color: #fff;
    border: none;
    border-radius: 5px;
    padding: 10px 20px;
    cursor: pointer;
    font-size: 16px;
  }

  #employeeForm input[type="submit"]:hover {
    background-color: #0056b3;
  }

  /* Vendor Form */
  #vendorForm {
    background-color: #f9f9f9;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
  }

  #vendorForm h2 {
    font-family: Montserrat;
    font-weight: 700;
    color: #0056b3;
    margin-bottom: 20px;
  }

  #vendorForm label {
    font-weight: 600;
  }

  #vendorForm input[type="text"],
  #vendorForm input[type="email"],
  #vendorForm input[type="tel"] {
    width: calc(100% - 40px);
    padding: 10px;
    margin-bottom: 10px;
    border: 1px solid #ccc;
    border-radius: 5px;
    font-size: 16px;
  }

  #vendorForm input[type="submit"] {
    background-color: #007bff;
    color: #fff;
    border: none;
    border-radius: 5px;
    padding: 10px 20px;
    cursor: pointer;
    font-size: 16px;
  }

  #vendorForm input[type="submit"]:hover {
    background-color: #0056b3;
  }
  
</style>

<body>
   <!-- SIDEBAR -->
  <%- include('./sidenavbar.ejs') %>
  <%- include('./alert_msg.ejs') %>

  <% function formatDateToDDMMYYYY(date) {
    const formattedDate = new Date(date);
    const day = String(formattedDate.getDate()).padStart(2, '0');
    const month = String(formattedDate.getMonth() + 1).padStart(2, '0'); // Months are zero-based
    const year = formattedDate.getFullYear();
    return `${day}-${month}-${year}`;
} %>
   


    <!-- CONTENT -->
    <section id="content">
      <nav>
        <i class='bx bx-transfer-alt'></i>
        <div class="container">
          <div class="right-aligned">
            <button  class="action-icon-btn" onclick="toggleForm('employeeForm')">Add Employee</button>
            <button class="action-icon-btn" onclick="toggleForm('vendorForm')">Add Vendor</button>
          </div>
        </div>
      </nav>


      <div class="overlay" onclick="closeForms()"></div>

      <div id="employeeForm" class="form-container">
        <h2 style="font-family: Montserrat; font-weight: 700; color: #0056b3;">Add Employee</h2>
        <span class="close-icon" onclick="closeForm('employeeForm')"><i class='bx bx-x'></i></span>
        
        
        
        <form action="/add-employee" method="post">
          <label for="empName">Name:</label><br>
          <input type="text" id="empName" name="Name" style="width: 100%;" required ><br>
          <label for="empEmail">Email:</label><br>
          <input type="email" id="empEmail" name="Email" style="width: 100%;" required ><br>
          <label for="empPhone">Phone Number:</label><br>
          <input type="tel" id="empPhone" name="Number" style="width: 100%;" required ><br><br>
          <button type="submit" id="emp_submit">Add</button>
        </form>


      </div>

      <div id="vendorForm" class="form-container">
        <h2 style="font-family: Montserrat; font-weight: 700; color: #0056b3;">Add Vendor</h2>
        <span class="close-icon" onclick="closeForm('vendorForm')"><i class='bx bx-x'></i></span>
        <form action="/add-vendor" method="post">
          <label for="vendorName">Business Name:</label><br>
          <input type="text" id="vendorName" name="Business_name" style="width: 100%;" required ><br>
          <label for="vendorEmail">Business Email:</label><br>
          <input type="email" id="vendorEmail" name="Business_email" style="width: 100%;" required ><br>
          <label for="vendorPhone">Business Contact Number:</label><br>
          <input type="tel" id="vendorPhone" name="Business_contact_number" style="width: 100%;" required ><br><br>
          <button type="submit" id="emp_submit">Add</button>
        </form>
      </div>

      <!-- MAIN -->
      <main id="mainDashboard">
        <div class="head-title">
          <div class="left">
            <h1>Dashboard</h1>
            <ul class="breadcrumb">
              <li>
                <a href="#">Dashboard</a>
              </li>
              <li><i class='bx bx-chevron-right'></i></li>
              <li>
                <a class="active" href="#">Home</a>
              </li>
            </ul>
          </div>

        </div>

        <ul class="box-info">
          <li>
           <%
            const currentDate = new Date();


const currentMonthStart = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
const currentMonthEnd = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0);


const objectsInCurrentMonth = Lot_data.filter(obj => obj.Purchase_date >= currentMonthStart && obj.Purchase_date <= currentMonthEnd);


const totalPayableSum = objectsInCurrentMonth.reduce((accumulator, currentValue) => {
    return accumulator + currentValue.Total_payable;
}, 0);

const objectsInCurrentMonth_fuel = fuel_data.filter(obj => obj.Date >= currentMonthStart && obj.Date <= currentMonthEnd);


const totalPayableSum_fuel = objectsInCurrentMonth_fuel.reduce((accumulator, currentValue) => {
    return accumulator + currentValue.Total;
}, 0);

const objectsInCurrentMonth_reimbursement = reimbursement_data.filter(obj => obj.Date >= currentMonthStart && obj.Date <= currentMonthEnd);


const totalPayableSum_reimbursement = objectsInCurrentMonth_reimbursement.reduce((accumulator, currentValue) => {
    return accumulator + currentValue.Amount;
}, 0);

          
     %>       

            <i class='bx bxs-cart-alt'></i>
            <span class="text">
              <h3>₹ <%=totalPayableSum%></h3>
              <p>Total Spent on Items (paid+unpaid)</p>
            </span>
          </li>
          <li>
            <!-- <i class="bx bx-cart"></i> -->
            <i class="bx bx-package"></i>
            <span class="text">
              <h3>₹ <%=totalPayableSum_fuel%></h3>
              <p>Spent On Fuel This Month</p>
            </span>
          </li>
          <li>
            <i class='bx bxs-shopping-bag'></i>
            <span class="text">
              <h3>₹ <%=totalPayableSum_reimbursement%></h3>
              <p>Total Amount Reimbursed This Month</p>
            </span>
          </li>
          <li>
            <i class='bx bx-rupee'></i>

            <span class="text">
              <h3>₹ <%= totalPayableSum_reimbursement+totalPayableSum_fuel+totalPayableSum %></h3>
              <p>Total Money Spent This Month</p>
            </span>
          </li>
        </ul>

