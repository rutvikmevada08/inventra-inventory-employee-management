// employees graph 

const employeeData = dayWiseData.reduce((acc, curr) => {
    if (!acc[curr.Vendor.Business_name]) {
      acc[curr.Vendor.Business_name] = 0;
    }
    acc[curr.Vendor.Business_name] += curr.Total_payable;
    return acc;
  }, {});

  const employeeNames = Object.keys(employeeData);
