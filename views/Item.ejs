<style>
   button {
    padding: 10px 20px;
    margin-right: 10px;
    background-color: #007bff;
    color: #fff;
    border: none;
    cursor: pointer;
  }

  button:hover {
    background-color: #0056b3;
  }

  .container {
    position: relative;
    width: 100%;
  }

  .right-aligned {
    position: absolute;
    top: -22px;
    right: 0;
  }

  .right-aligned button {
    border-radius: 5px;
  }

  .overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 999;
  }

  .close-icon {
    position: absolute;
    top: 10px;
    right: 10px;
    cursor: pointer;
    font-size: 20px;
    color: #ccc;
  }

  .close-icon:hover {
    color: #555;
  }

  .form-container {
    display: none;
    position: absolute;
    top: 50%;
    left: 50%;
    width: 60%;
    transform: translate(-50%, -50%);
    background-color: #fff;
    padding: 20px;
    border-radius: 5px;
    z-index: 1000;
  }

  .form-container.active {
    display: block;
  }


   /* item Form */
  #itemForm {
    background-color: #f9f9f9;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    width: 50%;
  }

  #itemForm h2 {
    font-family: Montserrat;
    font-weight: 700;
    color: #0056b3;
    margin-bottom: 20px;
  }

  #itemForm label {
    font-weight: 600;
  }

  #itemForm input[type="text"],
  #itemForm input[type="email"],
  #itemForm input[type="tel"] {
    width: calc(100% - 40px);
    padding: 10px;
    margin-bottom: 10px;
    border: 1px solid #ccc;
    border-radius: 5px;
    font-size: 16px;
  }

  #itemForm input[type="submit"] {
    background-color: #007bff;
    color: #fff;
    border: none;
    border-radius: 5px;
    padding: 10px 20px;
    cursor: pointer;
    font-size: 16px;
  }

  #itemForm input[type="submit"]:hover {
    background-color: #0056b3;
  }

</style>
