<% if(message.length > 0){ %>
    <div id="messageAlert" class="alert" style="color: white; ">
        <i class="fas fa-info-circle"></i> <%= message[0] %>
        <span class="close-icon" onclick="dismissAlert('messageAlert')">&times;</span>
    </div>
  <% } %>
  
  <% if(bad_alert.length > 0){ %>
    <div id="badAlert" class="alert" style="color: white; ">
        <i class="fas fa-exclamation-circle"></i> <%= bad_alert[0] %>
        <span class="close-icon" onclick="dismissAlert('badAlert')">&times;</span>
    </div>
  <% } %>
  
  <style>
    .alert {
        position: fixed;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        padding: 7px;   
        text-align: center;
        border: 1px solid transparent;
        animation: fadeOut 5s ease-in-out forwards;
        z-index: 9999999;
        display: inline-block;
        min-width: 286px;
    }
    #messageAlert {
        background-color: rgb(76,175,80,0.7);
    }
  
    #badAlert {
        background-color: rgba(255, 0, 0, 0.7);
    }
  
    .close-icon {
        position: absolute;
        top: 5px;
        right: 10px;
        cursor: pointer;
        color: white;
        font-size: 20px;
    }
  
    @keyframes fadeOut {
        0% {
            opacity: 1;
        }
        100% {
            opacity: 0;
            display: none;
        }
    }
  </style>
  
  <script>
    function dismissAlert(alertId) {
        var alertElement = document.getElementById(alertId);
        if (alertElement) {
            alertElement.style.display = 'none';
        }
    }
  </script>
  