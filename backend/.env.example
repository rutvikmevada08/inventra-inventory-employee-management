# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=5000

# Use a database name of your own. The old app used the default "test" database;
# the new one must NOT point at the same database (see scripts/migrate-legacy.js).
MONGODB_URI=mongodb://127.0.0.1:27017/smart_inventory

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# Invoice uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# Optional e-mail notifications. Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Who is told about new item and reimbursement requests (comma-separated)
NOTIFY_EMAILS=

# Used in the investor sheet export
COMPANY_NAME=Your Company
DEFAULT_PAID_BY=
# INR per USD used for the USD columns (the original sheet used 73.7)
USD_RATE=73.7
