{
  "name": "smart-inventory-workforce-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node backend/server.js",
    "server": "node backend/server.js",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "test": "node test/run-all-tests.js && npm --prefix backend test && npm --prefix frontend test -- --run",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test -- --run",
    "test:integration": "node test/run-all-tests.js",
    "create-admin": "npm --prefix backend run create-admin",
    "migrate:legacy": "npm --prefix backend run migrate:legacy",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.2",
    "connect-flash": "^0.1.1",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.6",
    "debug": "~2.6.9",
    "dotenv": "^18.0.6",
    "ejs": "~2.6.1",
    "exceljs": "^4.4.0",
    "express": "~4.16.1",
    "express-session": "^1.18.0",
    "express-validator": "^7.0.1",
    "http-errors": "~1.6.3",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.30.1",
    "mongoose": "^8.2.0",
    "morgan": "~1.9.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "pdfkit": "^0.20.2",
    "serve-index": "^1.9.1"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
